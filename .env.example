# ── Copy to .env.local for local testing; in production set these in Vercel → Settings → Environment Variables ──

# The mailbox that owns the calendar and sends the mails
HOST_EMAIL=info@maincharacter.nl
# Calendar the appointments go into ("primary" = the main calendar of HOST_EMAIL)
HOST_CALENDAR_ID=primary
# Calendars whose busy times block a slot (comma separated). Leave empty = only HOST_CALENDAR_ID
BUSY_CALENDAR_IDS=primary
# Team addresses that get a copy of every booking / change / cancellation (comma separated)
NOTIFY_EMAILS=info@maincharacter.nl
# Public address of the tool, used for links in the mails
PUBLIC_URL=https://afspraken.maincharacter.nl
# Long random strings — generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOKING_SECRET=
CRON_SECRET=

# ── Google access: use ONE of the two ──
# A) Production: service account with domain-wide delegation (never expires) — paste the whole JSON key
GOOGLE_SERVICE_ACCOUNT_JSON=
# B) Testing: OAuth refresh token (stops working after 7 days if the OAuth app is in "Testing")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Zoom (optional). Without these, every call gets a Google Meet link instead ──
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# The licensed Zoom user who hosts the calls
ZOOM_USER=
